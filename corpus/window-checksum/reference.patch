-        out[w] = wchk_window(data, len, w, width);
+
+    /* Consecutive windows differ by one byte leaving and one arriving, so the
+     * first is summed and the rest are carried forward. The modulus is applied
+     * on every step exactly as before, and the subtraction is done by adding
+     * the complement so the accumulator never underflows. */
+    uint32_t acc = 0;
+    for (size_t i = 0; i < width; i++) {
+        acc = wchk_add(acc, data[i]);
+    }
+    out[0] = acc;
+
+    for (size_t w = 1; w < windows; w++) {
+        acc = (acc + WCHK_MOD - (data[w - 1] % WCHK_MOD)) % WCHK_MOD;
+        acc = wchk_add(acc, data[w + width - 1]);
+        out[w] = acc;
     }
     return windows;
 }
