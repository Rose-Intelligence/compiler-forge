+/* First position whose key is >= probe. The keys are sorted, so this is the
+ * only fact either query needed. */
+static size_t si_lower_bound(const si_index *index, const char *probe)
+{
+    size_t lo = 0;
+    size_t hi = index->count;
+    while (lo < hi) {
+        size_t mid = lo + (hi - lo) / 2;
+        if (si_key_cmp(index->keys[mid], probe) < 0) {
+            lo = mid + 1;
+        } else {
+            hi = mid;
+        }
+    }
+    return lo;
+}
