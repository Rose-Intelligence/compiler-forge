-        if (si_key_cmp(index->keys[i], key) == 0) {
-            return i;
-        }
+    /* Lower bound, then one equality check. Returning the first of any run of
+     * equal keys matches what the scan did. */
+    size_t at = si_lower_bound(index, key);
+    if (at < index->count && si_key_cmp(index->keys[at], key) == 0) {
+        return at;
     }
