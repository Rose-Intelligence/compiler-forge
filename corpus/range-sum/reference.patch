 struct rs_table {
     long *values;
     size_t count;
+    /* Running totals carried once across the sequence: prefix_sum[i] is the sum
+     * of the first i values, prefix_even[i] the count of even values among them.
+     * Either query is then one subtraction. */
+    long *prefix_sum;
+    size_t *prefix_even;
 };
 
