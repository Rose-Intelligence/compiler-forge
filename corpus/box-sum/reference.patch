--- a/src/boxsum.c
+++ b/src/boxsum.c
@@ -14,6 +14,11 @@
     long *cells;
     size_t rows;
     size_t cols;
+    /* Summed-area tables, (rows+1) x (cols+1). sat[i][j] covers cells above and
+     * left of (i, j). Formed once; every query is four corner reads. */
+    long *sat_sum;
+    long *sat_pos;
+    size_t w;   /* cols + 1 */
 };
 
 bs_grid *bs_build(const long *cells, size_t rows, size_t cols)
@@ -24,13 +29,31 @@
     }
     size_t n = rows * cols;
     g->cells = calloc(n > 0 ? n : 1, sizeof *g->cells);
-    if (g->cells == NULL) {
-        free(g);
+    g->w = cols + 1;
+    size_t sn = (rows + 1) * (cols + 1);
+    g->sat_sum = calloc(sn, sizeof *g->sat_sum);
+    g->sat_pos = calloc(sn, sizeof *g->sat_pos);
+    if (g->cells == NULL || g->sat_sum == NULL || g->sat_pos == NULL) {
+        bs_free(g);
         return NULL;
     }
     memcpy(g->cells, cells, n * sizeof *cells);
     g->rows = rows;
     g->cols = cols;
+
+    for (size_t i = 1; i <= rows; i++) {
+        for (size_t j = 1; j <= cols; j++) {
+            long v = cells[(i - 1) * cols + (j - 1)];
+            g->sat_sum[i * g->w + j] = bs_add(v, 0)
+                + g->sat_sum[(i - 1) * g->w + j]
+                + g->sat_sum[i * g->w + (j - 1)]
+                - g->sat_sum[(i - 1) * g->w + (j - 1)];
+            g->sat_pos[i * g->w + j] = (bs_positive(v) ? 1 : 0)
+                + g->sat_pos[(i - 1) * g->w + j]
+                + g->sat_pos[i * g->w + (j - 1)]
+                - g->sat_pos[(i - 1) * g->w + (j - 1)];
+        }
+    }
     return g;
 }
 
@@ -40,6 +63,8 @@
         return;
     }
     free(g->cells);
+    free(g->sat_sum);
+    free(g->sat_pos);
     free(g);
 }
 
@@ -68,13 +93,10 @@
     if (!clamp_rect(g, &r0, &c0, &r1, &c1)) {
         return 0;
     }
-    long acc = 0;
-    for (size_t r = r0; r <= r1; r++) {
-        for (size_t c = c0; c <= c1; c++) {
-            acc = bs_add(acc, g->cells[r * g->cols + c]);
-        }
-    }
-    return acc;
+    const long *s = g->sat_sum;
+    size_t w = g->w;
+    return s[(r1 + 1) * w + (c1 + 1)] - s[r0 * w + (c1 + 1)]
+         - s[(r1 + 1) * w + c0] + s[r0 * w + c0];
 }
 
 size_t bs_box_positive(const bs_grid *g, size_t r0, size_t c0, size_t r1, size_t c1)
@@ -82,13 +104,9 @@
     if (!clamp_rect(g, &r0, &c0, &r1, &c1)) {
         return 0;
     }
-    size_t seen = 0;
-    for (size_t r = r0; r <= r1; r++) {
-        for (size_t c = c0; c <= c1; c++) {
-            if (bs_positive(g->cells[r * g->cols + c])) {
-                seen++;
-            }
-        }
-    }
-    return seen;
+    const long *s = g->sat_pos;
+    size_t w = g->w;
+    long v = s[(r1 + 1) * w + (c1 + 1)] - s[r0 * w + (c1 + 1)]
+           - s[(r1 + 1) * w + c0] + s[r0 * w + c0];
+    return (size_t)v;
 }
